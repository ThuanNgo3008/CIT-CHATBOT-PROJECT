# Copy this file to .env and fill in the values. Never commit real values.
OPENAI_API_KEY=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
# Required by docker-compose.yml, app/services/rag_service.py, and pipeline/load.py.
QDRANT_API_KEY=
# Optional. Defaults to http://localhost:6333 for scripts run on the host.
QDRANT_URL=
# Optional comma-separated web origins. Empty blocks cross-origin browser requests.
CORS_ALLOWED_ORIGINS=
